        {
          "id": "7a3c053e-8361-4f02-8b35-34d93e76ea5d",
          "name": "Get Portfolio Summary Graph",
          "request": {
            "name": "Get Portfolio Summary Graph",
            "description": {
              "content": "Returns time-series portfolio snapshots for the authenticated account. Optional query parameter `range` controls the bucket size: 7d (default), 24h, 30d, or all.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "portfolio",
                "summary",
                "graph"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "range",
                  "value": "7d",
                  "description": "Time range for bucketing: 7d (default), 24h, 30d, or all"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
