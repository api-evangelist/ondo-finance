        {
          "id": "0d4379ff-69fc-4b82-924a-dbf3df02123f",
          "name": "Get Token Balances for a User or Token",
          "request": {
            "name": "Get Token Balances for a User or Token",
            "description": {
              "content": "This endpoint retrieves all token balances for a GM Chain. Results can be optionally filtered by `tokenAddress`, `userAddress`, or both parameters together. If no filters are provided, all balances on the chain will be returned.\n\nFor caching details on this endpoint, please see: [Endpoint Caching](https://docs.ondo.finance/api-reference/endpoint-caching).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "chains",
                ":chainId",
                "balances"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "tokenAddress",
                  "value": "<string>",
                  "description": "Filter by a token contract address (optional)."
                },
                {
                  "disabled": false,
                  "key": "userAddress",
                  "value": "<string>",
                  "description": "Filter by a user wallet address (optional)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "chainId",
                  "description": "(Required) The chain's identifier including the chain name and chain id."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
