        {
          "info": {
            "name": "Remove Address Book Entry",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.gm.ondo.finance/v1/wallet/address_book",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Remove a withdrawal address from the address book."
