        "name": "Wallet",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Withdraw",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gm.ondo.finance/v1/withdraw",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a withdrawal request. Rate limited per account."
        },
        {
          "info": {
            "name": "Provision Deposit Address",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gm.ondo.finance/v1/provision_address",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Provision a new deposit address for a given symbol/chain."
        },
        {
          "info": {
            "name": "Get Withdrawal Status",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gm.ondo.finance/v1/get_withdrawal_status",
