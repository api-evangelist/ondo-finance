        {
          "info": {
            "name": "Export Withdrawals CSV",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gm.ondo.finance/v1/wallet/withdrawals/csv",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Export withdrawals as CSV for a time range."
