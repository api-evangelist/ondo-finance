        {
          "info": {
            "name": "Export Deposits CSV",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gm.ondo.finance/v1/wallet/deposits/csv",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Export deposits as CSV for a time range."
